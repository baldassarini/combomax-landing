<!-- BakeUp Combo Max: HTML original aprimorado. Mockups ilustrativos de uma confeitaria fictícia. -->
<!DOCTYPE html>

<html lang="pt-BR">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>BakeUp | Combo Max — Sua confeitaria com presença digital profissional</title>
<link href="data:image/png;base64," rel="icon"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&amp;family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&amp;display=swap" rel="stylesheet"/>
<style>
  :root{
    --sage:#7C9A7E; --sage-dark:#4F6B51; --cream:#F5F0E8; --bg:#FAFAF7;
    --ink:#2C2C2A; --ink-soft:#5F5E5A; --beige:#D4C5A9;
    --terracota:#C0644A; --terracota-light:#FAECE7; --gold:#B8860B;
    --success:#5A8A5C; --sage-light:#EAF2EA;
    --shadow: 0 10px 30px rgba(44,44,42,0.09);
    --shadow-soft: 0 3px 14px rgba(44,44,42,0.06);
    --shadow-lift: 0 18px 40px rgba(44,44,42,0.14);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:16.5px;line-height:1.62;-webkit-font-smoothing:antialiased;}
  h1,h2,h3,h4{font-family:'Playfair Display',serif;color:var(--ink);margin:0 0 .5em 0;font-weight:600;letter-spacing:-0.01em;}
  p{margin:0 0 1em 0;}
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .icon{width:1em;height:1em;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
  .wrap{max-width:1100px;margin:0 auto;padding:0 24px;}
  .eyebrow{font-size:.76rem;text-transform:uppercase;letter-spacing:.16em;color:var(--sage-dark);font-weight:700;margin-bottom:.9em;display:inline-flex;align-items:center;gap:8px;}
  .eyebrow::before{content:"";width:18px;height:1.5px;background:var(--gold);display:inline-block;}
  .btn{display:inline-flex;align-items:center;gap:8px;font-family:'DM Sans',sans-serif;font-weight:700;font-size:.95rem;padding:14px 30px;border-radius:50px;text-decoration:none;border:none;cursor:pointer;transition:transform .22s cubic-bezier(.22,1,.36,1), box-shadow .22s ease, background .22s ease;}
  .btn-primary{background:var(--sage-dark);color:#fff;box-shadow:0 6px 18px rgba(79,107,81,.28);}
  .btn-primary:hover{transform:translateY(-3px);box-shadow:0 12px 26px rgba(79,107,81,.36);}
  .btn-gold{background:var(--gold);color:#fff;box-shadow:0 8px 22px rgba(184,134,11,.32);}
  .btn-gold:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(184,134,11,.4);}
  .btn-outline{background:transparent;color:var(--sage-dark);border:1.5px solid var(--sage-dark);}
  .btn-outline:hover{background:var(--sage-dark);color:#fff;transform:translateY(-2px);}
  .btn-ghost{background:rgba(255,255,255,.14);color:#fff;border:1.5px solid rgba(255,255,255,.55);}
  .btn-ghost:hover{background:rgba(255,255,255,.24);transform:translateY(-2px);}
  .btn-sm{padding:10px 22px;font-size:.85rem;}
  .btn:active{transform:translateY(0) scale(.97);}

  .reveal{opacity:0;transform:translateY(20px);transition:opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1);}
  .reveal.in{opacity:1;transform:translateY(0);}
  .stagger.in > *{opacity:1;transform:translateY(0) scale(1);}
  .stagger > *{opacity:0;transform:translateY(14px) scale(.98);transition:opacity .5s cubic-bezier(.22,1,.36,1), transform .5s cubic-bezier(.22,1,.36,1);}
  .stagger > *:nth-child(1){transition-delay:.02s;} .stagger > *:nth-child(2){transition-delay:.09s;}
  .stagger > *:nth-child(3){transition-delay:.16s;} .stagger > *:nth-child(4){transition-delay:.23s;}
  .stagger > *:nth-child(5){transition-delay:.3s;} .stagger > *:nth-child(6){transition-delay:.37s;}

  header.site-header{position:sticky;top:0;z-index:50;background:rgba(250,250,247,.9);backdrop-filter:blur(10px);border-bottom:1px solid rgba(44,44,42,.06);}
  .header-inner{display:flex;align-items:center;justify-content:space-between;padding:12px 24px;max-width:1100px;margin:0 auto;}
  .logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
  .logo img{height:34px;width:auto;transition:transform .3s ease;}
  .logo:hover img{transform:scale(1.05);}
  .logo-word{font-family:'Playfair Display',serif;font-weight:700;font-size:1.28rem;color:var(--ink);}
  .logo-word .dot-os{color:var(--sage-dark);}

  .trust-strip{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:26px;margin-top:2.6em;padding-top:1.8em;border-top:1px solid rgba(44,44,42,.09);opacity:0;animation:riseIn .8s cubic-bezier(.22,1,.36,1) .5s forwards;}
  .trust-item{display:flex;align-items:center;gap:8px;font-size:.82rem;color:var(--ink-soft);font-weight:500;}
  .trust-item .icon{color:var(--sage-dark);width:16px;height:16px;}

  .hero{padding:88px 0 66px;position:relative;overflow:hidden;}
  .hero::before{content:"";position:absolute;top:-130px;right:-130px;width:380px;height:380px;background:radial-gradient(circle,var(--sage-light) 0%,transparent 70%);z-index:0;animation:float1 14s ease-in-out infinite;}
  .hero::after{content:"";position:absolute;bottom:-150px;left:-150px;width:400px;height:400px;background:radial-gradient(circle,var(--terracota-light) 0%,transparent 70%);z-index:0;animation:float2 16s ease-in-out infinite;}
  @keyframes float1{0%,100%{transform:translate(0,0);}50%{transform:translate(-18px,22px);}}
  @keyframes float2{0%,100%{transform:translate(0,0);}50%{transform:translate(20px,-18px);}}
  .hero-grid{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:0 24px;display:flex;flex-wrap:wrap;align-items:center;gap:20px 56px;}
  .hero-inner{flex:1 1 440px;max-width:600px;text-align:left;}
  .hero h1{font-size:clamp(2.1rem,4.2vw,3.15rem);line-height:1.14;opacity:0;animation:riseIn .8s cubic-bezier(.22,1,.36,1) .1s forwards;}
  .hero .eyebrow{opacity:0;animation:riseIn .7s cubic-bezier(.22,1,.36,1) forwards;justify-content:flex-start;}
  .hero .lede{font-size:1.1rem;color:var(--ink-soft);max-width:540px;margin:0 0 2.1em;opacity:0;animation:riseIn .8s cubic-bezier(.22,1,.36,1) .22s forwards;}
  .hero-ctas{display:flex;flex-wrap:wrap;gap:14px;justify-content:flex-start;opacity:0;animation:riseIn .8s cubic-bezier(.22,1,.36,1) .34s forwards;}
  @keyframes riseIn{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}

  .journey{padding:16px 0 50px;position:relative;}
  .journey-head{text-align:center;max-width:640px;margin:0 auto 48px;padding:0 24px;}
  .journey-head .eyebrow{justify-content:center;}
  .journey-head h2{font-size:clamp(1.55rem,3vw,2.05rem);}
  .journey-head p{color:var(--ink-soft);font-size:1rem;}
  .trail{display:grid;grid-template-columns:repeat(5,1fr);gap:0;position:relative;max-width:1100px;margin:0 auto;padding:0 24px;}
  .trail::before{content:"";position:absolute;top:26px;left:9%;right:9%;height:2px;background:repeating-linear-gradient(to right,var(--beige) 0 8px,transparent 8px 16px);z-index:0;}
  .stage{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;text-align:center;text-decoration:none;color:var(--ink);padding:0 8px;background:none;border:none;font-family:inherit;cursor:pointer;}
  .stage-num{width:54px;height:54px;border-radius:50%;background:#fff;border:2px solid var(--sage);display:flex;align-items:center;justify-content:center;margin-bottom:14px;transition:all .28s cubic-bezier(.22,1,.36,1);box-shadow:var(--shadow-soft);color:var(--sage-dark);}
  .stage-num .icon{width:22px;height:22px;stroke-width:1.7;}
  .stage:hover .stage-num,.stage.active .stage-num{background:var(--sage-dark);border-color:var(--sage-dark);color:#fff;transform:scale(1.1) translateY(-3px);box-shadow:var(--shadow-lift);}
  .stage-eyebrow{font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--sage-dark);margin-bottom:4px;transition:color .2s ease;}
  .stage.active .stage-eyebrow{color:var(--terracota);}
  .stage-name{font-family:'Playfair Display',serif;font-size:.94rem;font-weight:600;line-height:1.3;}

  .carousel-section{padding:0 0 30px;}
  .carousel-wrap{position:relative;max-width:900px;margin:0 auto;padding:0 24px;}
  .carousel-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding:8px 0 6px;scrollbar-width:none;-ms-overflow-style:none;}
  .carousel-track::-webkit-scrollbar{display:none;}
  .card-slot{flex:0 0 100%;scroll-snap-align:center;display:flex;justify-content:center;padding:0 6px;}
  .product-card{
    width:100%;max-width:720px;background:#fff;border-radius:16px;box-shadow:var(--shadow);
    padding:30px clamp(22px,4vw,42px) 26px;border-top:5px solid var(--sage);
    display:flex;flex-direction:column;gap:16px;
    transition:transform .4s cubic-bezier(.22,1,.36,1), box-shadow .4s ease, opacity .4s ease;
    opacity:.45;transform:scale(.92);
  }
  .product-card.is-active{opacity:1;transform:scale(1);box-shadow:var(--shadow-lift);}
  .product-card[data-accent="sagelight"]{border-top-color:var(--sage-light);}
  .product-card[data-accent="sage"]{border-top-color:var(--sage);}
  .product-card[data-accent="sagedark"]{border-top-color:var(--sage-dark);}
  .product-card[data-accent="gold"]{border-top-color:var(--gold);}
  .product-card[data-accent="terracota"]{border-top-color:var(--terracota);}
  .product-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
  .stage-tag{display:inline-flex;align-items:center;gap:7px;background:var(--sage-light);color:var(--sage-dark);font-size:.7rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;padding:6px 14px;border-radius:50px;}
  .stage-tag .icon{width:13px;height:13px;}
  .step-index{font-family:'Playfair Display',serif;font-size:.8rem;color:var(--beige);font-weight:700;}
  .product-name{font-size:.8rem;font-weight:700;color:var(--ink-soft);letter-spacing:.01em;}
  .product-card h3{font-size:clamp(1.22rem,2.1vw,1.44rem);line-height:1.24;margin-bottom:0;}
  .product-copy p{color:var(--ink-soft);font-size:.9rem;margin-bottom:.7em;}
  .product-copy p.punch{color:var(--ink);font-weight:500;}
  .includes{background:var(--cream);border-radius:12px;padding:16px 20px;}
  .includes h4{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--sage-dark);margin-bottom:9px;font-family:'DM Sans',sans-serif;font-weight:700;}
  .includes ul{margin:0;padding:0;list-style:none;}
  .includes li{padding:3px 0 3px 22px;position:relative;font-size:.84rem;color:var(--ink);}
  .includes li::before{content:"🍪";position:absolute;left:0;font-size:.7rem;top:5px;}
  .product-foot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding-top:14px;border-top:1px solid rgba(44,44,42,.08);margin-top:auto;}
  .for-who{font-size:.8rem;color:var(--ink-soft);}
  .for-who b{color:var(--ink);}

  .carousel-nav{display:flex;align-items:center;justify-content:center;gap:20px;margin-top:14px;}
  .car-btn{width:42px;height:42px;border-radius:50%;background:#fff;border:1.5px solid var(--sage);color:var(--sage-dark);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:var(--shadow-soft);transition:all .25s cubic-bezier(.22,1,.36,1);flex-shrink:0;}
  .car-btn:hover{background:var(--sage-dark);color:#fff;transform:scale(1.08);}
  .car-btn .icon{width:17px;height:17px;stroke-width:2.2;}
  .car-dots{display:flex;gap:8px;}
  .car-dot{width:7px;height:7px;border-radius:50%;background:var(--beige);cursor:pointer;transition:all .3s cubic-bezier(.22,1,.36,1);border:none;padding:0;}
  .car-dot.active{background:var(--sage-dark);width:24px;border-radius:5px;}

  @media (max-width:640px){
    .trail{gap:2px;}
    .stage-name{font-size:.7rem;}
    .stage-num{width:42px;height:42px;}
    .stage-num .icon{width:18px;height:18px;}
    .trail::before{top:20px;}
    .product-card{padding:24px 18px 20px;gap:12px;}
  }

  /* ---- COMBO: dark hero card ---- */
  .combo-wrap{padding:20px 0 40px;}
  .combo{max-width:1120px;margin:0 auto;background:linear-gradient(165deg,var(--sage-dark) 0%,#3d5640 100%);color:#F5F0E8;border-radius:20px;overflow:hidden;box-shadow:0 26px 60px rgba(79,107,81,.32);position:relative;}
  .combo::before{content:"";position:absolute;top:-80px;right:-80px;width:280px;height:280px;background:radial-gradient(circle,rgba(184,134,11,.18) 0%,transparent 70%);pointer-events:none;}
  .combo-badge-row{padding:54px clamp(24px,6vw,64px) 0;text-align:center;position:relative;z-index:1;}
  .combo-badge{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:#fff;font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:8px 20px;border-radius:50px;margin-bottom:24px;box-shadow:0 6px 16px rgba(0,0,0,.18);}
  .combo-badge .icon{width:13px;height:13px;}
  .combo h2{color:#fff;font-size:clamp(1.85rem,4vw,2.7rem);text-align:center;max-width:720px;margin:0 auto 16px;}
  .combo .combo-lede{text-align:center;max-width:600px;margin:0 auto 8px;color:rgba(245,240,232,.88);font-size:1.06rem;}
  .combo .combo-hook{text-align:center;font-family:'Playfair Display',serif;font-style:italic;font-size:1.12rem;color:#fff;margin:26px auto 44px;position:relative;display:table;}
  .combo .combo-hook::before,.combo .combo-hook::after{content:"";position:absolute;top:50%;width:34px;height:1px;background:rgba(255,255,255,.4);}
  .combo .combo-hook::before{left:-46px;} .combo .combo-hook::after{right:-46px;}

  .combo-grid{padding:0 clamp(24px,6vw,64px) 48px;display:grid;grid-template-columns:repeat(5,1fr);gap:14px;position:relative;z-index:1;}
  .combo-item{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:22px 15px;text-align:center;transition:all .3s cubic-bezier(.22,1,.36,1);}
  .combo-item:hover{background:rgba(255,255,255,.12);transform:translateY(-6px);border-color:rgba(255,255,255,.3);}
  .combo-item .ic-circ{width:42px;height:42px;border-radius:50%;background:rgba(184,134,11,.24);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--gold);}
  .combo-item .ic-circ .icon{width:19px;height:19px;stroke:#F0D9A0;}
  .combo-item h5{font-family:'DM Sans',sans-serif;font-weight:700;font-size:.83rem;color:#fff;margin:0 0 5px;}
  .combo-item p{font-size:.76rem;color:rgba(245,240,232,.75);margin:0;line-height:1.5;}

  .combo-price-block{background:#fff;color:var(--ink);margin:0 clamp(24px,6vw,64px);border-radius:16px;position:relative;z-index:1;box-shadow:0 20px 44px rgba(0,0,0,.2);}
  .combo-price-inner{display:flex;flex-wrap:wrap;gap:28px;align-items:center;justify-content:space-between;padding:32px clamp(20px,4vw,40px);}
  .price-main .old-context{font-size:.84rem;color:var(--ink-soft);margin-bottom:6px;}
  .price-amount{font-family:'Playfair Display',serif;font-size:2.6rem;font-weight:700;color:var(--sage-dark);line-height:1;}
  .price-amount span{font-size:1.05rem;font-weight:500;color:var(--ink-soft);}
  .price-sub{font-size:.86rem;color:var(--ink-soft);margin-top:8px;}
  .price-pix{display:inline-flex;align-items:center;gap:6px;margin-top:12px;background:var(--terracota-light);color:var(--terracota);font-weight:700;font-size:.8rem;padding:7px 16px;border-radius:50px;}
  .combo-note{padding:24px clamp(24px,6vw,64px) 46px;font-size:.8rem;color:rgba(245,240,232,.65);text-align:center;max-width:680px;margin:0 auto;position:relative;z-index:1;}

  /* ---- INFO CARD: separate light card, para quem + faq ---- */
  .info-card-wrap{max-width:1120px;margin:34px auto 0;padding:0;}
  .info-card{background:#fff;border-radius:20px;box-shadow:var(--shadow);overflow:hidden;}

  .who-section{padding:52px clamp(24px,6vw,64px) 8px;}
  .block-head{text-align:center;max-width:560px;margin:0 auto 34px;}
  .block-head .eyebrow{justify-content:center;}
  .block-head h4{font-size:1.55rem;}
  .who-cols{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
  .who-col{border-radius:14px;padding:26px 26px 22px;border-top:4px solid transparent;}
  .who-col.yes{background:var(--sage-light);border-top-color:var(--sage-dark);}
  .who-col.no{background:var(--terracota-light);border-top-color:var(--terracota);}
  .who-col .who-icon{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
  .who-col .who-icon .icon{width:16px;height:16px;stroke-width:2.4;color:#fff;}
  .who-col.yes .who-icon{background:var(--sage-dark);}
  .who-col.no .who-icon{background:var(--terracota);}
  .who-col h4{font-family:'Playfair Display',serif;font-size:1.08rem;margin-bottom:14px;}
  .who-col.yes h4{color:var(--sage-dark);}
  .who-col.no h4{color:var(--terracota);}
  .who-col ul{margin:0;padding:0;list-style:none;}
  .who-col li{padding:7px 0 7px 24px;position:relative;font-size:.89rem;color:var(--ink);display:flex;gap:8px;align-items:flex-start;}
  .who-col li .icon{width:14px;height:14px;flex-shrink:0;margin-top:3px;position:absolute;left:0;}
  .who-col.yes li .icon{color:var(--success);}
  .who-col.no li .icon{color:var(--terracota);}

  .divider-row{display:flex;align-items:center;gap:16px;padding:44px clamp(24px,6vw,64px) 0;}
  .divider-row .line{flex:1;height:1px;background:rgba(44,44,42,.09);}
  .divider-row .dot{width:6px;height:6px;border-radius:50%;background:var(--beige);}

  .faq-section{padding:38px clamp(24px,6vw,64px) 10px;}
  .faq-list{max-width:700px;margin:0 auto;}
  details.faq-item{border-bottom:1px solid rgba(44,44,42,.1);padding:16px 2px;}
  details.faq-item summary{cursor:pointer;font-weight:700;font-size:.94rem;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px;transition:color .2s ease;}
  details.faq-item summary:hover{color:var(--sage-dark);}
  details.faq-item summary::-webkit-details-marker{display:none;}
  .faq-plus{width:22px;height:22px;border-radius:50%;background:var(--sage-light);color:var(--sage-dark);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .3s cubic-bezier(.22,1,.36,1), background .2s ease;}
  .faq-plus .icon{width:11px;height:11px;stroke-width:2.4;}
  details.faq-item[open] .faq-plus{transform:rotate(135deg);background:var(--sage-dark);color:#fff;}
  details.faq-item p{margin-top:11px;color:var(--ink-soft);font-size:.89rem;padding-right:20px;}

  .cta-card{margin:40px clamp(24px,6vw,64px) 0;background:var(--cream);border-radius:16px;text-align:center;padding:40px 28px;}
  .cta-card p.pre{font-family:'Playfair Display',serif;font-style:italic;font-size:1.1rem;color:var(--sage-dark);margin-bottom:22px;}
  .info-card > .faq-section:last-of-type{padding-bottom:0;}
  .info-card-bottom-space{height:52px;}

  @media (max-width:820px){.combo-grid{grid-template-columns:repeat(2,1fr);} .who-cols{grid-template-columns:1fr;gap:18px;}}
  @media (max-width:520px){.combo-price-inner{flex-direction:column;align-items:flex-start;}}

  /* ---- ECOSYSTEM (signature closing section) ---- */
  .ecosystem{padding:86px 0 100px;}
  .eco-panel{max-width:1100px;margin:0 auto;padding:0 24px;}
  .eco-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:0;background:var(--sage-dark);border-radius:22px;overflow:hidden;box-shadow:0 24px 54px rgba(79,107,81,.26);}
  .eco-left{padding:56px 44px;display:flex;flex-direction:column;justify-content:center;position:relative;}
  .eco-left::after{content:"";position:absolute;top:-60px;left:-60px;width:200px;height:200px;background:radial-gradient(circle,rgba(184,134,11,.2) 0%,transparent 70%);}
  .eco-left .eyebrow{color:var(--beige);}
  .eco-left .eyebrow::before{background:var(--gold);}
  .eco-left h2{color:#fff;font-size:clamp(1.6rem,3vw,2.15rem);position:relative;z-index:1;}
  .eco-left p{color:rgba(245,240,232,.82);font-size:.98rem;position:relative;z-index:1;}
  .eco-right{background:var(--bg);padding:44px clamp(28px,4vw,50px);display:flex;flex-direction:column;justify-content:center;gap:0;}
