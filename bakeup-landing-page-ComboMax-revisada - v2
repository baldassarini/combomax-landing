<script>
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} });
  },{root:null, rootMargin:'0px 0px -8% 0px', threshold:0});
  document.querySelectorAll('.reveal, .stagger').forEach(el=>io.observe(el));

  const track = document.getElementById('track');
  const cards = Array.from(track.querySelectorAll('.product-card'));
  const dotsWrap = document.getElementById('dots');
  const stages = Array.from(document.querySelectorAll('.stage'));

  cards.forEach((c,i)=>{
    const d = document.createElement('button');
    d.className = 'car-dot' + (i===0 ? ' active' : '');
    d.setAttribute('aria-label', 'Ir para produto ' + (i+1));
    d.addEventListener('click', ()=> scrollToCard(i));
    dotsWrap.appendChild(d);
  });
  const dots = Array.from(dotsWrap.children);

  function scrollToCard(i){
    cards[i].scrollIntoView({behavior:'smooth', inline:'center', block:'nearest'});
  }
  document.getElementById('prevBtn').addEventListener('click', ()=>{
    const idx = getActiveIndex();
    scrollToCard(Math.max(0, idx-1));
  });
  document.getElementById('nextBtn').addEventListener('click', ()=>{
    const idx = getActiveIndex();
    scrollToCard(Math.min(cards.length-1, idx+1));
  });
  function getActiveIndex(){
    const i = dots.findIndex(d=>d.classList.contains('active'));
    return i>-1?i:0;
  }
  stages.forEach((s)=>{
    s.addEventListener('click', ()=>{
      const id = s.getAttribute('data-target');
      const i = cards.findIndex(c=>c.id===id);
      if(i>-1) scrollToCard(i);
    });
  });

  const cardObserver = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      const i = cards.indexOf(entry.target);
      if(entry.isIntersecting && entry.intersectionRatio > 0.6){
        entry.target.classList.add('is-active');
        dots.forEach((d,di)=>d.classList.toggle('active', di===i));
        stages.forEach(s=>s.classList.toggle('active', s.getAttribute('data-target')===entry.target.id));
      } else {
        entry.target.classList.remove('is-active');
      }
    });
  }, {root: track, threshold: [0, 0.6, 1]});
  cards.forEach(c=>cardObserver.observe(c));
</script>
